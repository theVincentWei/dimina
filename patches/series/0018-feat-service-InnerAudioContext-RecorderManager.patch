+	onCanplay: 'canplay',
+	onPlay: 'play',
+	onPause: 'pause',
+	onStop: 'stop',
+	onEnded: 'ended',
+	onTimeUpdate: 'timeUpdate',
+	onError: 'error',
+	onWaiting: 'waiting',
+	onSeeking: 'seeking',
+	onSeeked: 'seeked',
+	onLoadedmetadata: 'loadedmetadata',
