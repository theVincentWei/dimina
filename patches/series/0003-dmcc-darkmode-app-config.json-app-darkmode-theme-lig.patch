+.page {
+	min-height: 100vh;
+	padding: 48rpx 32rpx;
+	box-sizing: border-box;
+	background-color: #f7f7f7;
+}
+
+.card {
+	padding: 40rpx;
+	border-radius: 16rpx;
+	background-color: #ffffff;
+}
+
+.title {
+	font-size: 40rpx;
+	font-weight: 600;
+	color: #111111;
+}
+
+.row {
+	margin-top: 24rpx;
+}
+
+.label {
+	display: block;
+	font-size: 24rpx;
+	color: #8c8c8c;
+}
+
+.value {
+	font-size: 34rpx;
+	font-weight: 600;
+	color: #07c160;
+}
+
+.desc {
+	font-size: 26rpx;
+	line-height: 1.6;
+	color: #444444;
+}
+
+/* 页面内容层深浅色切换:与壳层 theme.json 变量独立,由 WebView 原生媒体查询驱动 */
+@media (prefers-color-scheme: dark) {
+	.page {
+		background-color: #111111;
+	}
+
+	.card {
+		background-color: #1a1a1a;
+	}
+
+	.title {
+		color: #f5f5f5;
+	}
+
+	.desc {
+		color: #b3b3b3;
+	}
+}
