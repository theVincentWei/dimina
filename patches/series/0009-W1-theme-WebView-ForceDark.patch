- pushSystemInfoPatchToJsCore 补 currentJsTheme 注入(Utils 构建器不含 theme,缺了基础库 if(!theme) return 丢 patch,wx.onThemeChange 永不触发)
- applyWebViewColorScheme:宿主 targetSdk=28 WebView prefers-color-scheme 恒 light(现代 API 需 33+),走 legacy ForceDark——声明 darkmode 包 ON(内容算法反转可读),未声明 OFF(永远浅色);feature-check FORCE_DARK
- 接线五点:withWebView 两立即分支(创建点 onWebViewReady/onTabWebViewReady 各补一行防首帧白闪)+reapplyThemeStyles 全量循环
- 测试 +3 source-pin(theme 注入/ForceDark 门禁/接线计数=2)
---
 .../dimina/ui/container/DiminaActivity.kt     | 37 +++++++++++++-
 .../DiminaActivityThemeWiringTest.kt          | 48 +++++++++++++++++++
 2 files changed, 84 insertions(+), 1 deletion(-)

diff --git a/android/dimina/src/main/kotlin/com/didi/dimina/ui/container/DiminaActivity.kt b/android/dimina/src/main/kotlin/com/didi/dimina/ui/container/DiminaActivity.kt
index a642422..20f1e2f 100644
--- a/android/dimina/src/main/kotlin/com/didi/dimina/ui/container/DiminaActivity.kt
+++ b/android/dimina/src/main/kotlin/com/didi/dimina/ui/container/DiminaActivity.kt
@@ -107,6 +107,8 @@ import androidx.core.content.ContextCompat
 import androidx.core.view.ViewCompat
 import androidx.core.view.WindowInsetsCompat
 import androidx.core.view.WindowInsetsControllerCompat
+import androidx.webkit.WebSettingsCompat
+import androidx.webkit.WebViewFeature
 import com.didi.dimina.Dimina
 import com.didi.dimina.api.device.ScanCodeOptions
 import com.didi.dimina.bean.AppConfig
@@ -926,6 +928,10 @@ class DiminaActivity : ComponentActivity() {
 
         // Update status bar style based on text style
         updateActionColorStyle(resolveThemeValue(rawTextStyle))
+
+        // WebView 内容色算法(ForceDark)随主题刷新:所有已创建的页面 WebView 一并覆盖
+        (listOfNotNull(webView) + tabPageStates.values.mapNotNull { it.webView })
+            .forEach(::applyWebViewColorScheme)
     }
 
     /** tabBar 五色(color/selectedColor/backgroundColor/borderStyle)按当前主题解析;未开 darkmode 原样返回。 */
@@ -958,7 +964,11 @@ class DiminaActivity : ComponentActivity() {
      */
     private fun pushSystemInfoPatchToJsCore() {
         val patch = JSONObject().apply {
-            put("systemInfo", Utils.getMiniProgramSystemInfo(this@DiminaActivity))
+            val systemInfo = Utils.getMiniProgramSystemInfo(this@DiminaActivity)
+            // Utils 构建器保持平台通用、不含 theme;这里按门禁补上,否则基础库
+            // if (!theme) return,wx.onThemeChange 永远不触发。
+            currentJsTheme()?.let { systemInfo.put("theme", it) }
+            put("systemInfo", systemInfo)
         }
         miniApp.peekJsCore(miniProgram.appId)?.postMessage("hostEnvUpdate", patch)
     }
@@ -999,6 +1009,27 @@ class DiminaActivity : ComponentActivity() {
         }
     }
 
+    /**
+     * WebView 内容深浅色。宿主 targetSdk=28,WebView 对 targetSdk<33 的应用
+     * prefers-color-scheme 恒报 light(算法化适配 API 不可用),只能走 legacy
+     * ForceDark。语义:声明 darkmode 的小程序页面内容算法反转,深色下可读;
+     * 未声明永远 OFF(纯浅色,与现状一致)。FORCE_DARK 不支持时静默跳过。
+     */
+    @Suppress("DEPRECATION")
+    private fun applyWebViewColorScheme(target: WebView) {
+        if (!WebViewFeature.isFeatureSupported(WebViewFeature.FORCE_DARK)) {
+            return
+        }
+        WebSettingsCompat.setForceDark(
+            target.settings,
+            if (isDarkModeEnabled()) {
+                WebSettingsCompat.FORCE_DARK_ON
+            } else {
+                WebSettingsCompat.FORCE_DARK_OFF
+            },
+        )
+    }
+
     private fun isLightColor(color: Color): Boolean {
         val argb = color.toArgb()
         val red = android.graphics.Color.red(argb)
@@ -1515,6 +1546,7 @@ class DiminaActivity : ComponentActivity() {
         if (useTabBarContainer.value) {
             val state = tabPageStates[selectedTabIndex.intValue]
             return state?.webView?.let {
+                applyWebViewColorScheme(it)
                 action(it)
                 true
             } ?: run {
@@ -1528,6 +1560,7 @@ class DiminaActivity : ComponentActivity() {
             }
         }
         return webView?.let {
+            applyWebViewColorScheme(it)
             action(it)
             true
         } ?: run {
@@ -1556,6 +1589,7 @@ class DiminaActivity : ComponentActivity() {
         }
         this.webView = webView
         webView.setBackgroundColor(parseCssColor(backgroundColor.value).toArgb())
+        applyWebViewColorScheme(webView)
         bindNativeComponentHost()
         LogUtils.d(tag, "WebView is now initialized and ready")
 
@@ -1585,6 +1619,7 @@ class DiminaActivity : ComponentActivity() {
         val state = tabPageStates[index] ?: return
         state.webView = webView
         webView.setBackgroundColor(parseCssColor(resolveThemeValue(state.configInfo.backgroundColor)).toArgb())
+        applyWebViewColorScheme(webView)
         if (index == selectedTabIndex.intValue) {
             this.webView = webView
         }
diff --git a/android/dimina/src/test/java/com/didi/dimina/ui/container/DiminaActivityThemeWiringTest.kt b/android/dimina/src/test/java/com/didi/dimina/ui/container/DiminaActivityThemeWiringTest.kt
index da903b0..590f6bb 100644
--- a/android/dimina/src/test/java/com/didi/dimina/ui/container/DiminaActivityThemeWiringTest.kt
+++ b/android/dimina/src/test/java/com/didi/dimina/ui/container/DiminaActivityThemeWiringTest.kt
@@ -1,5 +1,6 @@
 package com.didi.dimina.ui.container
 
+import org.junit.Assert.assertEquals
 import org.junit.Assert.assertFalse
 import org.junit.Assert.assertTrue
 import org.junit.Test
@@ -185,4 +186,51 @@ class DiminaActivityThemeWiringTest {
             source.contains("resolvedTabBarConfig?.takeIf { shouldShowTabBar }"),
         )
     }
+
+    @Test
+    fun `systemInfo patch carries the current theme so onThemeChange can fire`() {
+        val body = bodyOf("pushSystemInfoPatchToJsCore")
+        assertTrue(
+            "the patch builder must inject currentJsTheme - Utils.getMiniProgramSystemInfo has no theme, " +
+                "and the base library drops theme-less patches (if (!theme) return)",
+            body.contains("""currentJsTheme()?.let { systemInfo.put("theme", it) }"""),
+        )
+    }
+
+    @Test
+    fun `webview force dark is gated on darkmode with feature check`() {
+        val body = bodyOf("applyWebViewColorScheme")
+        assertTrue(
+            "force dark must be feature-checked - unsupported WebView versions must stay untouched",
+            body.contains("WebViewFeature.isFeatureSupported(WebViewFeature.FORCE_DARK)"),
+        )
+        assertTrue(
+            "force dark must only turn ON for packages that declared darkmode",
+            body.contains("if (isDarkModeEnabled())") &&
+                body.contains("WebSettingsCompat.FORCE_DARK_ON") &&
+                body.contains("WebSettingsCompat.FORCE_DARK_OFF"),
+        )
+    }
+
+    @Test
+    fun `webview force dark is applied at entry, creation and theme ticks`() {
+        val withWebViewBody = bodyOf("withWebView")
+        assertEquals(
+            "both withWebView immediate branches must apply the scheme before the action",
+            2,
+            Regex("applyWebViewColorScheme\\(it\\)").findAll(withWebViewBody).count(),
+        )
+        assertTrue(
+            "reapplyThemeStyles must re-cover every created webview (main + all tab pages)",
+            bodyOf("reapplyThemeStyles").contains("forEach(::applyWebViewColorScheme)"),
+        )
+        assertTrue(
+            "the main webview creation point must set the scheme before first paint",
+            bodyOf("onWebViewReady").contains("applyWebViewColorScheme(webView)"),
+        )
+        assertTrue(
+            "the tab webview creation point must set the scheme before first paint",
+            bodyOf("onTabWebViewReady").contains("applyWebViewColorScheme(webView)"),
+        )
+    }
 }
